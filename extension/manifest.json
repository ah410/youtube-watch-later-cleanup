{
  "manifest_version": 3,
  "name": "YouTube Watch Later Cleanup",
  "version": "1.0.0",
  "description": "Removes every video from your YouTube Watch Later playlist with one click.",
  "action": {
    "default_title": "Watch Later Cleanup",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": ["activeTab", "scripting"]
}
